{
  "name": "Eco Route — Python 3.11",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "postCreateCommand": "python -m pip install pip==26.3 && python -m pip install -r requirements.lock",
  "postAttachCommand": {
    "server": "python -m streamlit run app.py --server.address 0.0.0.0"
  },
  "portsAttributes": {
    "8501": {"label": "Eco Route", "onAutoForward": "openPreview"}
  },
  "forwardPorts": [8501]
}
